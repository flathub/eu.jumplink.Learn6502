{
    "id": "eu.jumplink.Learn6502",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.node24",
        "org.freedesktop.Sdk.Extension.typescript"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/node24/bin:/usr/lib/sdk/typescript/bin:/app/bin"
    },
    "command": "eu.jumplink.Learn6502",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "modules": [
        {
            "name": "Learn6502",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/JumpLink/Learn6502.git",
                    "tag": "v0.8.3",
                    "commit": "36fbfea77cd1f5c43595dba2e6a90047ccfc44e8",
                    "disable-submodules": true,
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v(\\d+\\.\\d+\\.\\d+)$",
                        "version-scheme": "semantic"
                    }
                },
                "gjsify-sources.json"
            ]
        }
    ]
}
